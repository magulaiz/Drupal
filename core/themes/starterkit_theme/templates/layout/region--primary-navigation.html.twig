{#
/**
 * @file
 * Theme override to display primary menu region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{% set identifier = 'region-primary-navigation' %}
{%
  set classes = [
    'region',
    identifier,
  ]
%}
{% if content %}
  <button class="primary-nav__mobile-button" data-drupal-selector="primary-nav__mobile-button">
    <span class="visually-hidden">{{ 'Menu'|t }}</span>
    <span class="mobile-nav-button__icon"></span>
  </button>
  <div{{ attributes.addClass(classes).setAttribute('id', identifier).setAttribute('data-drupal-selector', identifier) }}>
    <div class="region-primary-navigation__scrollable">
      {{ content }}
    </div>
  </div>
  <div class="primary-nav-overlay" data-drupal-selector="primary-nav-overlay"></div>

{% endif %}
