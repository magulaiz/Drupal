{#
/**
 * @file
 * Template file for the theming of announcement_feed off-canvas dialog.
 *
 * This template will get rendered when the user clicks the announcement button in the toolbar.
 *
 * Available variables:
 * - count: Contains the total number of announcements.
 * - featured: A list of featured announcements. Each item contains:
 *   - id: Unique id of the announcement.
 *   - title: Title of the featured announcement.
 *   - teaser: Short description of the announcement.
 *   - link: Learn more link of the featured announcement.
 *   - new: Tells if it's an unread announcement or not.
 * - standard: A list of non-featured announcements. Each item contains:
 *   - id: Unique id of the announcement.
 *   - title: Title of the standard announcement.
 *   - teaser: Short description of the announcement.
 *   - timestamp: Timestamp of the announcement.
 *   - link: Learn more link of the standard announcement.
 *   - new: Tells if it's an unread announcement or not.
 *
 * @see announcements_feed_theme()
 *
 * @ingroup themeable
 */
#}
{% if count %}
  <nav class="announcements">
    <ul>
      {% if featured|length %}
        {% for announcement in featured %}
          <li class="announcement announcement--featured" data-drupal-featured>
            <div class="announcement__title">
              <h4>{{ announcement.title }}</h4>
            </div>
            <div class="announcement__teaser">
              {{ announcement.teaser }}
            </div>
            {% if announcement.new %}
              <span class="announcement__new">{{ 'New'|t }}</span>
            {% endif %}
            <div class="announcement__link">
              {% if announcement.link %}
                <a href="{{ announcement.link }}">{{ 'Learn More'|t }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      {% endif %}
      {% for announcement in standard %}
        <li class="announcement announcement--standard">
          <div class="announcement__title">
            <a href="{{ announcement.link }}">{{ announcement.title }}</a>
            {% if announcement.new %}
              <span class="announcement__new">{{ 'New'|t }}</span>
            {% endif %}
            <div class="announcement__date">{{ announcement.timestamp | format_date('short') }}</div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% else %}
  <div class="announcements announcements--empty"><p> {{ 'No announcements available'|t }}</p></div>
{% endif %}
