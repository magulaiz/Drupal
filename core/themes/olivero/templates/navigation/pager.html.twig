{#
/**
 * @file
 * Theme override to display a pager.
 *
 * Available variables:
 * - heading_id: Identifies the ID attribute of the pagination heading.
 * - pagination_heading_level: Specifies the heading level (e.g., h2, h3) to use for the pager.
 * - first: A pager item component representing the link to the first page.
 * - previous: A pager item component linking to the previous page.
 * - next: A pager item component linking to the next page.
 * - last: A pager item component linking to the last page.
 * - pages: Contains an array of pager item components used to generate the page links.
 *
 * @see template_preprocess_pager()
 */
#}

{{ include ('olivero:pager', {
  attributes,
  heading_id: heading_id|default('pagination-heading')|t|render,
  pagination_heading_level: pagination_heading_level|default('h2'),
  first: items.first,
  previous: items.previous,
  next: items.next,
  last: items.last,
  pages: items.pages,
  ellipses: ellipses|default([]),
}, with_context = false) }}
