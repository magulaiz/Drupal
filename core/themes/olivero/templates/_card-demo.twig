<div class="card-container">
  {% embed '@olivero/_card.twig' with {
      'title': 'Jenny I\'ve got your number'
    }
  %}
    {% block media %}
      <img src="https://placekitten.com/500/500" alt="">
    {% endblock %}

    {% block text %}
      <p>Jenny Jenny who can I turn to?
        You give me something I can hold on to.
        I know you'll think I'm like the others before.</p>
    {% endblock %}

    {% block cta %}
      <button class="button button--primary button--small">867-5309</button>
    {% endblock %}
  {% endembed %}

