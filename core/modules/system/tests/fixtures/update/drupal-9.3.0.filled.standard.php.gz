  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5949',
  'source' => 'Uploaded files can either be stored as <em>public</em> or <em>private</em>, depending on the <a href="!file-system">File system settings</a>. For more information, see the <a href="!system-help">System module help page</a>.',
