  'translation' => 'Añadiendo idiomas personalizados',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6821',
  'translation' => 'Usted puede elegir un idioma que no aparezca en la lista desplegable seleccionando <em>Idioma personalizado</em> al final de la lista. Después tendrá que configurar el código, nombre y dirección del idioma en el formulario facilitado.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6822',
  'translation' => 'Configurando los idiomas del contenido',
  'language' => 'es',
