->values(array(
  'lid' => '5908',
  'source' => '<strong>Configure your website</strong> Once logged in, visit the <a href="!admin">Administration page</a>, where you may <a href="!config">customize and configure</a> all aspects of your website.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5909',
  'source' => '<strong>Enable additional functionality</strong> Next, visit the <a href="!modules">Extend page</a> and enable modules that suit your specific needs. You can find additional modules at the <a href="!download_modules">Drupal.org modules page</a>.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5910',
  'source' => '<strong>Customize your website design</strong> To change the "look and feel" of your website, visit the <a href="!themes">Appearance page</a>. You may choose from one of the included themes or download additional themes from the <a href="!download_themes">Drupal.org themes page</a>.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5911',
  'source' => '<strong>Start posting content</strong> Finally, you may <a href="!content">add new content</a> to your website.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5912',
  'source' => 'For more information, refer to the subjects listed in the Help Topics section or to the <a href="!docs">online documentation</a> and <a href="!support">support</a> pages at <a href="!drupal">drupal.org</a>.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5913',
  'source' => 'The Help module displays explanations for using each module listed on the main <a href="!help">Help reference page</a>.',
