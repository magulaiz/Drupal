  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6824',
  'translation' => 'Si el módulo Block está activado, puede añadir un bloque de cambio de idioma en la página de <a href="!blocks">presentación del bloque</a> para permitir que los usuarios cambien el idioma.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6825',
  'translation' => 'Ajustando la visibilidad de un bloque según el idioma',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6826',
  'translation' => 'Si el módulo Block está activado, el módulo Language le permite establecer la visibilidad de un bloque en base a los idiomas seleccionados en la página de <a href="!blocks">presentación del bloque</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6827',
  'translation' => 'Eligiendo el idioma del usuario',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6828',
  'translation' => '<em>URL</em> establece el idioma de la interfaz en base al prefijo de la ruta o el dominio (por ejemplo, si se especifica <em>de</em> para alemán, se obtendrán URL como <em>example.com/de/contact</em>). El idioma por defecto no necesita un prefijo de ruta, pero también pse le puede asignar uno. Si la detección de idioma se realiza por el nombre de dominio, hay que especificar un dominio para cada idioma.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6829',
  'translation' => '<em>Sesión</em> determina el idioma de la interfaz mediante una solicitud o parámetro de sesión (por ejemplo, <em>example.com?language=de</em> establecería el idioma de la interfaz en alemán, basándose en el uso de <em>de</em> como parámetro de <em>idioma</em>).',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6830',
  'translation' => '<em>Usuario</em> adopta la configuración de idioma establecida en la página del perfil del usuario.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6831',
  'translation' => '<em>Idioma seleccionado</em> le permite especificar el idioma por defecto del sitio o un idioma específico como idioma de respaldo. Este método se debe colocar al final de la lista.',
  'language' => 'es',
