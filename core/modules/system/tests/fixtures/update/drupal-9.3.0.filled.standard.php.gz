  'version' => 'none',
))
->values(array(
  'lid' => '6760',
  'source' => 'Allow other users to contact you via a personal contact form which keeps your email address hidden. Note that some privileged users such as site administrators are still able to contact you even if you choose to disable this feature.',
  'context' => '',
  'version' => '8.0.0-beta12',
))
->values(array(
  'lid' => '6761',
