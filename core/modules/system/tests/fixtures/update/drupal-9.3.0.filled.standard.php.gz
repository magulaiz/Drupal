->values(array(
  'lid' => '6139',
  'translation' => 'Enviar el mensaje como texto plano, usando la función nativa de PHP mail()',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6140',
  'translation' => 'Colector de correo',
  'language' => 'es',
  'customized' => '0',
))
