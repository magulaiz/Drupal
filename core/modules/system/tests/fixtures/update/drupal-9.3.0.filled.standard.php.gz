))
->values(array(
  'lid' => '5989',
  'translation' => 'En orden para crear y modificar sus propias vistas usando la administración y configuración del interfaz de usuario, se necesitará habilitar si el módulo Views UI en el core o un módulo contribuido que provea una interfaz de usuario para Vistas. Ver la <a href="!views-ui">página de ayuda de Views UI</a> para más información.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5990',
