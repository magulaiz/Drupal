  'customized' => '0',
))
->values(array(
  'lid' => '2279',
  'translation' => 'Si se selecciona <em>Mostrar el bloque en todas las páginas</em>, el bloque contendrá los menús generados automáticamente para todos los libros del sitio. Si se selecciona <em>Mostrar el bloque sólo en las páginas de libros</em>, el bloque sólo contendrá el menú correspondiente al libro de la página actual. En este caso, si la página actual no está en un libro, no se desplegará ningún bloque. Pueden usarse las <em>Opciones de visibilidad específicas de página</em> u otras opciones de visibilidad además de desplegar selectivamente este bloque.',
  'language' => 'es',
  'customized' => '0',
