))
->values(array(
  'lid' => '5945',
  'source' => 'The <em>settings</em> and the <em>display</em> of the file field can be configured separately. See the <a href="!field_ui">Field UI help</a> for more information on how to manage fields and their display.',
  'context' => '',
  'version' => 'none',
))
