  'translation' => 'El tipo de comentario %label ha sido agregado.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6749',
  'translation' => 'La dirección de correo electrónico del autor del comentario.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6750',
  'translation' => 'Tipo de comentario',
  'language' => 'es',
