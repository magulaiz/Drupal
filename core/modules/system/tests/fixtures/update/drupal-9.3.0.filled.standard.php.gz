->values(array(
  'lid' => '6034',
  'translation' => 'El módulo Text module le permite crear campos de texto cortos y largos con sumarios opcionales. Consulte la  <a href="!field">ayuda del módulo Field</a> y las páginas de <a href="!field_ui">ayuda de Field UI</a> para obtener información general sobre los campos y cómo crearlos y gestionarlos. Para más información, ver la  <a href="!text_documentation">documentación en línea del módulo Text</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '6035',
