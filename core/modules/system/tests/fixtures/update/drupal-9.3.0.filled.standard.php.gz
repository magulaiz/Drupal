->values(array(
  'lid' => '6765',
  'source' => 'Enabling field translation',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6766',
  'source' => 'You can define which fields of a content entity can be translated. For example, you might want to translate the title and body field while leaving the image field untranslated. If you exclude a field from being translated, it will still show up in the content editing form, but any changes made to that field will be applied to <em>all</em> translations of that content.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6767',
  'source' => 'Changing the source language for a translation',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6768',
  'source' => 'When you add a new translation, the original text you are translating is displayed in the edit form as the <em>source</em>. If at least one translation of the original content already exists when you add a new translation, you can choose either the original content (default) or one of the other translations as the source, using the select list in the Source language section. After saving the translation, the chosen source language is then listed on the Translate tab of the content.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6769',
  'source' => 'Setting status of translations',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6770',
  'source' => 'If you edit a translation in one language you may want to set the status of the other translations as <em>out-of-date</em>. You can set this status by selecting the <em>Flag other translations as outdated</em> checkbox in the Translation section of the content editing form. The status will be visible on the Translations page.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '6771',
  'source' => 'To configure translation for this field, <a href="@language-settings-url">enable language support</a> for this type.',
  'context' => '',
  'version' => 'none',
