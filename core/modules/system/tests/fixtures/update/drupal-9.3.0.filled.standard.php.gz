->values(array(
  'lid' => '5772',
  'translation' => '<a href="!hal_spec">Hypertext Application Language (HAL)</a> es un formato que soporta el enlazamiento requerido para las APIs hipermedia.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5773',
  'translation' => 'Las APIs de hipermedia son un estilo de API Web que utiliza URIs para identificar recursos y las <a href="!link_rel">relaciones de enlace</a> entre ellos, habilitando consumidores de API para seguir enlaces para descubrir la funcionalidad de la API.',
