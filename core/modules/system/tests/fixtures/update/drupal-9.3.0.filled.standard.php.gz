))
->values(array(
  'lid' => '5947',
  'source' => 'In the field settings, you can define the allowed file extensions (for example <em>pdf docx psd</em>) for the files that will be uploaded with the file field.',
  'context' => '',
  'version' => 'none',
))
->values(array(
  'lid' => '5948',
