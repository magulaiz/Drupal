  'data' => 'a:8:{s:4:"uuid";s:36:"8e7dce93-d784-42f8-ae5e-94a4cde4b680";s:8:"langcode";s:2:"en";s:6:"status";b:1;s:12:"dependencies";a:0:{}s:4:"name";s:15:"Test vocabulary";s:3:"vid";s:15:"test_vocabulary";s:11:"description";s:0:"";s:6:"weight";i:0;}',
