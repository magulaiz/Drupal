))
->values(array(
  'lid' => '5908',
  'translation' => '<strong>Configure su sitio web</strong> Una vez que haya iniciado sesión, visite la <a href="!admin">página de Administración</a>, donde usted puede <a href="!config"> personalizar y configurar </a> todos los aspectos de su sitio web.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5909',
  'translation' => '<strong>Active opciones adicionales.</strong> Luego, visite la <a href="!modules">lista de módulos</a> y active las características que se ajusten a sus necesidades específicas. Puede encontrar módulos adicionales en la <a href="!download_modules">sección de descarga de módulos de Drupal.org</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5910',
  'translation' => '<strong>Personalice el diseño de su sitio web</strong> Para cambiar la "apariencia" de su sitio web, visite la <a href="!themes">sección temas</a>. Puede elegir uno de los temas incluidos o descargar temas adicionales de la <a href="!download_themes">sección de descarga de temas de Drupal.org</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5911',
  'translation' => '<strong>Empezar a escribir contenido</strong>. Finalmente, usted puede <a href="!content">añadir nuevo contenido</a> a su sitio.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5912',
  'translation' => 'Para mas información, vaya a los temas listados en  la sección de Tópicos de Ayuda o a la <a href="!docs">documentación en linea</a> y las páginas de <a href="!support">ayuda</a> en <a href="!drupal">drupal.org</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5913',
  'translation' => 'El módulo Help muestra explicaciones de uso para cada módulo en la <a href="!help">página principal de ayuda</a>.',
  'language' => 'es',
  'customized' => '0',
))
->values(array(
  'lid' => '5914',
  'translation' => '¿Está seguro de que quiere aplicar el efecto de imagen %name a todas las imágenes?',
  'language' => 'es',
