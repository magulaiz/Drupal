{%
  set classes = [
    'toolbar-title',
  ]
%}
{% if modifiers is iterable %}
  {% set classes = classes|merge(modifiers|map(modifier => "toolbar-title--#{modifier}")) %}
{% endif %}

{% if extra_classes is iterable %}
  {% set classes = classes|merge(extra_classes) %}
{% endif %}

<{{html_tag|default('h2')}}{{attributes.addClass(classes)}}>
  <svg class="toolbar-title__icon" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 256 256">
    <path d="M216.49,79.52l-56-56A12,12,0,0,0,152,20H56A20,20,0,0,0,36,40V216a20,20,0,0,0,20,20H200a20,20,0,0,0,20-20V88A12,12,0,0,0,216.49,79.52ZM160,57l23,23H160ZM60,212V44h76V92a12,12,0,0,0,12,12h48V212Z"></path>
  </svg>
  {% block content %}
    {{ content }}
  {% endblock %}
</{{html_tag|default('h2')}}>
