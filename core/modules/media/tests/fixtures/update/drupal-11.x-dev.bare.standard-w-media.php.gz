->values([
  'lid' => '8333',
  'translation' => 'Decide qué comentarios se muestran en el sitio web.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8334',
  'translation' => '¿Quién puede moderar los comentarios?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8335',
  'translation' => 'Documentación en línea para moderar comentarios',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8336',
  'translation' => 'Gestión de comentarios',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8337',
  'translation' => '¿Qué es un comentario?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8338',
  'translation' => '¿Qué es un tipo de comentario?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8339',
  'translation' => 'Los comentarios se dividen en <em>tipos de comentarios</em>, que son los subtipos de entidad para el tipo de entidad de comentario. Cada tipo de comentario tiene sus propios campos y su propia configuración de formulario y visualización; cada tipo se puede utilizar para comentar sobre un único tipo de entidad. Puede configurar diferentes tipos de comentarios para diferentes propósitos de comentarios en su sitio web; por ejemplo, puede configurar un tipo de comentario para recetas que tenga campos "¿Qué sabor tiene?" y "¿Funcionaron las instrucciones?", y otro tipo de comentario para entradas de blog que solo tiene un campo de cuerpo de comentario genérico.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8340',
  'translation' => '¿Qué es la moderación?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8341',
  'translation' => 'Descripción general de la gestión de comentarios',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8342',
  'translation' => 'Publicación de comentarios',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8343',
  'translation' => 'Configuración de comentarios',
  'language' => 'es',
