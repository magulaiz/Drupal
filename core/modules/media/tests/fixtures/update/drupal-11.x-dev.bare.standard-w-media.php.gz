->values([
  'lid' => '5560',
  'translation' => "\n        <p>Puede alinear imágenes, vídeos, comentarios y demás elementos a la izquierda, derecha o al centro. Por ejemplo:</p>\r\n        <ul>\r\n          <li>Alinear una imagen a la izquierda: <code>&lt;img src=\"\" data-align=\"left\" /&gt;</code></li>\r\n          <li>Alinear una imagen al centro: <code>&lt;img src=\"\" data-align=\"center\" /&gt;</code></li>\r\n          <li>Alinear una imagen a la derecha: <code>&lt;img src=\"\" data-align=\"right\" /&gt;</code></li>\r\n          <li>… y se puede aplicar esto a otros elementos, así: <code>&lt;video src=\"\" data-align=\"center\" /&gt;</code></li>\r\n        </ul>",
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '5561',
  'translation' => 'Alinear imágenes',
  'language' => 'es',
