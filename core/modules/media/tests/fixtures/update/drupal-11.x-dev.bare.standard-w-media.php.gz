  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8086',
  'translation' => 'La información del esquema para el módulo %module no se encuentra en la base de datos. Debe revisar manualmente las actualizaciones del módulo y su base de datos para verificar si alguna actualización ha sido pasada por alto, incluyendo %last_update_hook.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8087',
  'translation' => 'Agregue, elimine o reorganice los campos en formularios de contacto personales y de todo el sitio.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8088',
  'translation' => '¿Cuáles son los campos de los formularios de contacto?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8089',
  'translation' => 'Haga clic en <em> Administrar la pantalla del formulario </em> para cambiar el orden o la configuración de los campos en el formulario.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8090',
  'translation' => 'Configura los formularios de contacto personales para los usuarios registrados del sitio web.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8091',
  'translation' => 'En la sección <em> Configuración de contacto </em>, marque/desmarque la casilla para habilitar/deshabilitar el formulario de contacto para nuevas cuentas de usuario.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8092',
  'translation' => 'Pulse <em>Guardar configuración</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8093',
  'translation' => 'Clique <em>Añadir formulario de contacto</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8094',
  'translation' => 'Haga clic en <em> Guardar </em>. Debería ver su nuevo formulario de contacto en la tabla, junto con un enlace para verlo.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8095',
  'translation' => '¿Qué son los formularios de contacto?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8096',
  'translation' => 'Hay dos tipos diferentes de formularios de contacto proporcionados por el módulo de contacto central: formularios de contacto personal, que permiten a los usuarios contactar a otros usuarios en el sitio y formularios de contacto en todo el sitio, que permiten a los usuarios comunicarse con los gerentes o administradores del sitio. Un sitio puede tener más de un formulario de contacto en todo el sitio; Cada uno tiene sus propios campos para completar, destinatarios y URL; También puede cambiar los campos que se muestran en formularios de contacto personal.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8097',
  'translation' => 'Tareas de gestión de formularios de contacto',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8098',
  'translation' => 'Consulte los temas relacionados a continuación para obtener tareas específicas.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8099',
  'translation' => 'Si usted tiene uno o más módulos de seguimiento instalados en su sitio, consulte los temas relacionados que se listan a continuación para conocer las tareas específicas.',
  'language' => 'es',
  'customized' => '0',
])
->values([
