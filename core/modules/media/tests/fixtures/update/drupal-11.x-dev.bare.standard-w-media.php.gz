])
->values([
  'lid' => '6418',
  'translation' => 'Un intento automatizado de crear este directorio ha fallado, posiblemente debido a problemas con los permisos. Para continuar con la instalación, puede o bien crear el directorio y modificar sus permisos manualmente, o bien asegurarse de que el instalador tiene los permisos para crearlo automáticamente. Para más información, consulte INSTALL.txt o <a href=":handbook_url">el manual online</a>.',
  'language' => 'es',
