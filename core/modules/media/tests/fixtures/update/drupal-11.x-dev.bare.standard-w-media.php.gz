])
->values([
  'lid' => '8240',
  'translation' => 'Falló la conexión con el servidor. El servidor informa del siguiente error: <p class="error">@message</p> Si desea mas ayuda acerca de cómo agregar o actualizar código en el servidor, vea el <a href=":handbook_url">manual</a>.',
