->values([
  'lid' => '6531',
  'translation' => 'Esconder logo',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '6532',
  'translation' => "@display '@id': El componente '@name' ha sido desactivado porque sus ajustes dependen de dependencias eliminadas.",
  'language' => 'es',
