  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '6420',
  'translation' => 'La opción trusted_host_patterns no está configurada en settings.php. Esto podría llevar a vulnerabilidades de seguridad. Se <strong>recomienda encarecidamente</strong> configurarlo. Para más información, consulte <a href=":url">Protegiéndose contra ataques HTTP HOST Header</a>.',
