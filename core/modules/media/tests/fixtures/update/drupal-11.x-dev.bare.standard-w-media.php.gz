  'source' => 'On the next field settings page, enter the desired settings for the comment field:',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8316',
  'source' => '<em>Show reply form on the same page as comments</em>: whether the comment reply form is displayed on the same page as the comments. If this is not selected, clicking <em>Reply</em> will open a new page with the reply form.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8317',
  'source' => '<em>Default value</em>: each individual entity has its own comment settings, but here you can set defaults for the comment settings for this entity type or subtype. The comment settings values are:',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8318',
  'source' => '<em>Open</em>: comments are allowed.',
  'context' => '',
  'version' => 'none',
])
->values([
