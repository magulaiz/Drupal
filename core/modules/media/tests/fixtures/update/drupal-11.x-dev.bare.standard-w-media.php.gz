  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6260',
  'source' => 'The Database Logging module logs system events in the Drupal database. For more information, see the <a href=":dblog">online documentation for the Database Logging module</a>.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6261',
  'source' => 'The Database Logging module allows you to view an event log on the <a href=":dblog">Recent log messages</a> page. The log is a chronological list of recorded events containing usage data, performance data, errors, warnings and operational information. Administrators should check the log on a regular basis to ensure their site is working properly.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6262',
  'source' => 'In case of errors or problems with the site, the <a href=":dblog">Recent log messages</a> page can be useful for debugging, since it shows the sequence of events. The log messages include usage information, warnings, and errors.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6263',
  'source' => 'The maximum number of messages to keep in the database log. Requires a <a href=":cron">cron maintenance task</a>.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6264',
  'source' => 'Pages which are suitable for caching are cached the first time they are requested, then the cached version is served for all later requests. Dynamic content is handled automatically so that both cache correctness and hit ratio is maintained.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6265',
  'source' => 'Internal Dynamic Page Cache',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6266',
  'source' => 'On the <a href=":formats">Text formats and editors page</a> you can see which text editor is associated with each text format. You can change this by clicking on the <em>Configure</em> link, and then choosing a text editor or <em>none</em> from the <em>Text editor</em> drop-down list. The text editor will then be displayed with any text field for which this text format is chosen.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6267',
  'source' => 'The <em>settings</em> and the <em>display</em> of the entity reference field can be configured separately. See the <a href=":field_ui">Field UI help</a> for more information on how to manage fields and their display.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6268',
  'source' => 'No eligible views were found. <a href=":create">Create a view</a> with an <em>Entity Reference</em> display, or add such a display to an <a href=":existing">existing view</a>.',
  'context' => '',
