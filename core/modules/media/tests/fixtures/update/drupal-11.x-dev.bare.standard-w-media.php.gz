  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8709',
  'translation' => 'En el menú de administración <em>Administrar</em>, vaya a <em>Configuración</em> &gt; <em>Sistema</em> &gt; <em>@cron_link</em>. Anote la hora de la <em>última ejecución</em> en la página.',
