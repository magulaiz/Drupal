])
->values([
  'lid' => '8181',
  'translation' => 'Una fecha definida por el usuario. Compruebe el<a href="https://www.php.net/manual/datetime.format.php#refsect1-datetime.format-parameters">manual de PHP</a> para conocer las opciones disponibles.',
