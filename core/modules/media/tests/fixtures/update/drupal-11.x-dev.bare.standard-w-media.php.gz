  'source' => 'Who can configure comments?',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8313',
  'source' => 'Follow the steps in the related <em>Adding a field to an entity sub-type</em> topic to add a field of type <em>Comments</em> to the desired entity type or sub-type.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8314',
  'source' => "On the first field settings page, choose the <em>Comment type</em> to use for this entity type or sub-type. You'll also notice that the <em>Allowed number of values</em> field cannot be changed for comment fields.",
