  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9066',
  'source' => 'Enter a word from the module name or description into the filter box, to make the list of modules smaller. Locate the module you want to uninstall.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9067',
  'source' => 'In the <em>Description</em> column, see if there are reasons that this module cannot be uninstalled. For example, you may have created content using this module (which you would need to delete first), or there may be another module installed that requires this module to be installed (you would need to uninstall the other module first).',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
