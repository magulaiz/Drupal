])
->values([
  'lid' => '6187',
  'translation' => 'Funcionando en modo de mantenimiento. <a href=":url">Volver a conectar</a> el sitio web.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '6188',
  'translation' => 'Tamaño de campo de texto: @size',
