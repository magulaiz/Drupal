  'customized' => '0',
])
->values([
  'lid' => '6007',
  'translation' => 'Para más información, consulte el <a href="https://www.drupal.org/upgrade">manual de actualización</a>. Si no está seguro de lo que puedan significar esos términos, tal vez debería contactar su proveedor de hosting.',
