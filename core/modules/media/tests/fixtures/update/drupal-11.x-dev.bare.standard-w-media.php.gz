->values([
  'lid' => '4574',
  'translation' => 'La serialización es el proceso de convertir estructuras de datos como matrices y objetos en cadenas. Esto permite a los datos ser representados de una manera que facilita su intercambio y almacenamiento (por ejemplo, para transmitir a través de Internet o para almacenar en un sistema de archivos local). Estas representaciones se pueden a continuación deserializar para recuperar las estructuras originales de datos.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '4575',
