  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8069',
  'translation' => 'También puede ejecutar cron manualmente, pero esta no es la forma recomendada de asegurarse de que se ejecute periódicamente.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8070',
  'translation' => 'Si desea ejecutar cron ahora mismo, haga clic en <em>Ejecutar cron</em> y espere a que termine cron.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8071',
  'translation' => 'Si no está configurando una tarea externa y tiene instalado el módulo principal Automated Cron, seleccione un horario para las ejecuciones cron automatizadas en <em>Configuración de Cron</em> & gt; <em>Ejecute cron cada</em>. Haz clic en <em>Guardar configuración</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8072',
  'translation' => '¿Qué es un módulo?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8073',
  'translation' => '¿Qué es un módulo experimental?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8074',
  'translation' => 'Un módulo <em> Experimental </em> es un módulo que todavía está en desarrollo y aún no es estable. No se recomienda el uso de módulos experimentales en sitios de producción.',
  'language' => 'es',
  'customized' => '0',
])
->values([
