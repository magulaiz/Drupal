  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7935',
  'translation' => 'Si solo desea cambiar la región donde se encuentra un bloque, o el orden de los bloques dentro de una región, arrastre los bloques a sus posiciones deseadas y haga clic en <em>Guardar bloques</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7936',
  'translation' => 'Si desea cambiar configuraciones adicionales, busque la región donde se encuentra actualmente el bloque que desea actualizar y haga clic en <em>Configurar</em> en la línea de la descripción del bloque.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7937',
  'translation' => 'Edite la configuración del bloque. La configuración disponible varía según el módulo que proporciona el bloque, pero para todos los bloques puede cambiar:',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7938',
  'translation' => '<em>Título del bloque</em>: La cabecera del bloque en tu sitio — para algunos bloques, necesitará marcar la  casilla de verificación <em>Sobrescribir título</em> para poder introducir un título.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7939',
  'translation' => '<em>Mostrar título</em>: marque la casilla si desea que se muestre el título',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7940',
  'translation' => '<em>Visibilidad</em>: agregue condiciones para cuándo se debe mostrar el bloque',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7941',
  'translation' => '<em>Región</em>: cambie la región del tema en la que se muestra el bloque',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7942',
  'translation' => 'Haga clic en <em>Guardar bloque</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7943',
  'translation' => '¿Qué son los bloques?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7944',
  'translation' => 'Los bloques son cajas de contenido representados en un área o región de una página web de su sitio. Los bloques se colocan y configuran específicamente para cada tema.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7945',
  'translation' => '¿Qué es la descripción del bloque?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7946',
  'translation' => 'La descripción del bloque es un nombre de identificación para un bloque, que se muestra en la interfaz administrativa. No se muestra en el sitio.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7947',
  'translation' => '¿Qué es el título del bloque?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7948',
  'translation' => 'El título del bloque es el encabezado que se muestra opcionalmente a los visitantes del sitio cuando el bloque se coloca en una región.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7949',
  'translation' => 'Coloque un bloque en la región de un tema.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7950',
  'translation' => 'Haga clic en el nombre del tema en el que desea colocar el bloque.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7951',
  'translation' => 'Busque la región donde desea colocar el bloque y haga clic en el <em>Colocar bloque</em> de esa región. Aparecerá un cuadro de diálogo modal.',
  'language' => 'es',
  'customized' => '0',
