  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8345',
  'translation' => '¿Qué es la edición rápida?',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8346',
  'translation' => 'Encuentre el enlace contextual para la parte de la página que desea editar. Por ejemplo, si desea editar la configuración para un bloque, el enlace debe estar en la esquina superior derecha del bloque o la parte superior izquierda para los idiomas de derecha a izquierda.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8347',
  'translation' => 'Haga sus ediciones y envíe el formulario.',
  'language' => 'es',
