  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8082',
  'translation' => 'Cuando esté haciendo cambios, haga click en <em>Guardar</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8083',
  'translation' => 'Haga click en <em>Crear una nueva cuenta</em>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8084',
