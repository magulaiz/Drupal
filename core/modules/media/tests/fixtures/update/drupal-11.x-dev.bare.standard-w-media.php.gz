  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7970',
  'translation' => 'En el menú administrativo <em>Administrar</em>, dirígete a <em>Configuración</em> & gt; <em>Búsqueda y metadatos</em> & gt; <em>Páginas de búsqueda</em>.',
