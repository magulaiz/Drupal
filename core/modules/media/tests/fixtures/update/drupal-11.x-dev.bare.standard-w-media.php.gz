->values([
  'lid' => '8520',
  'translation' => 'La compilación actual de CKEditor 5 requiere los siguientes elementos y atributos: <br><code>@list</code><br>Faltan los siguientes elementos: <br><code>@diff</code>',
  'language' => 'es',
