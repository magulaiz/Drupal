])
->values([
  'lid' => '7296',
  'translation' => 'Para editar bloques in situ, haga clic en el botón <strong>Editar</strong> de la barra de herramientas y luego haga clic en el bloque, o seleccione "Edición rápida" en el enlace contextual del bloque. (Consulte la ayuda del módulo <a href=":contextual">Enlaces contextuales</a> para obtener más información sobre cómo utilizar los enlaces contextuales.)',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7297',
