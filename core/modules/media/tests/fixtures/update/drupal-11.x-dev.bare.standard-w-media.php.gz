->values([
  'lid' => '7671',
  'translation' => 'Esta @label está siendo editada por el usuario @user y, por lo tanto, está bloqueada para que otros la editen. Este bloqueo tiene una antiguadad de @age. Haga clic aquí para <a href=":url">romper este bloqueo</a>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7672',
  'translation' => 'Esto también eliminará 1 instancia de bloque colocada. Esta acción no se puede deshacer.Esto también eliminará @count las instancias de bloque colocadas. Esta acción no se puede deshacer.',
