  'translation' => 'En el menú administrativo <em>Administrar</em>, vaya a <em>Configuración</em> &gt; <em>Desarrollo</em> &gt; <em>Sincronización de configuración</em> &gt; <em>Importar</em> &gt; <em>@single_import_link</em>.',
