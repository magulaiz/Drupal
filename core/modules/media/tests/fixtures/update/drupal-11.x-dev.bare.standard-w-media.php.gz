])
->values([
  'lid' => '5562',
  'translation' => 'Utiliza un atributo <code>data-align</code> en las etiquetas <code>&lt;img&gt;</code> para alinear las imágenes.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '5563',
  'translation' => "\n        <p>Puedes subtitular imágenes, vídeos, blockquotes, etc. Ejemplo:</p>\r\n        <ul>\r\n            <li><code>&lt;img src=\"\" data-caption=\"Esto es un subtitulo\" /&gt;</code></li>\r\n            <li><code>&lt;video src=\"\" data-caption=\"El baile de Drupal\" /&gt;</code></li>\r\n            <li><code>&lt;blockquote data-caption=\"Dries Buytaert\"&gt;¡Drupal es impresionante!&lt;/blockquote&gt;</code></li>\r\n            <li><code>&lt;code data-caption=\"Hola mundo en JavaScript.\"&gt;alert(\"¡Hola Mundo!\");&lt;/code&gt;</code></li>\r\n        </ul>",
  'language' => 'es',
  'customized' => '0',
])
->values([
