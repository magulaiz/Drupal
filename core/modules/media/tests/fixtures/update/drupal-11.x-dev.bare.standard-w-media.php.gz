])
->values([
  'lid' => '6214',
  'source' => '<a href=":login">Log in</a> or <a href=":register">register</a> to post comments',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6215',
  'source' => '<a href=":login">Log in</a> to post comments',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '6216',
