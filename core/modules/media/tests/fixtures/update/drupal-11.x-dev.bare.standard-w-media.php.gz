  'customized' => '0',
])
->values([
  'lid' => '7669',
  'translation' => 'Si se selecciona y este enlace de menú tiene hijos, el menú siempre aparecerá expandido. Esta opción se puede anular para todo el árbol de menú al colocar un bloque de menú.',
  'language' => 'es',
