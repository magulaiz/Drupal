->values([
  'lid' => '8171',
  'source' => 'Drupal is an open source platform for building amazing digital experiences. It’s made, used, taught, documented, and marketed by the <a href="@drupal_community">Drupal community</a>. Our community is made up of people from around the world with a shared set of <a href="@drupal_values">values</a>, collaborating together in a respectful manner. As we like to say:',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8172',
  'source' => 'Come for the code, stay for the community.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8173',
  'source' => 'There are a few ways to get started with Drupal:',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8174',
  'source' => '<a href="@drupal_user_guide">User Guide:</a> Includes installing, administering, site building, and maintaining the content of a Drupal website.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8175',
  'source' => '<a href="@create_content">Create Content:</a> Want to get right to work? Start adding content. <strong>Note:</strong> the information on this page will go away once you add content to your site. Read on and bookmark resources of interest.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8176',
  'source' => '<a href="@drupal_extend">Extend Drupal:</a> Drupal’s core software can be extended and customized in remarkable ways. Install additional functionality and change the look of your site using addons contributed by our community.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8177',
  'source' => 'Bookmark these links to our active Drupal community groups and support resources.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8178',
