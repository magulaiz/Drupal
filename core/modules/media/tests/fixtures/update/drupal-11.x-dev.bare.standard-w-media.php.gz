  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7967',
  'translation' => 'El módulo principal Help muestra temas de ayuda y proporciona un bloque de ayuda que se puede colocar en páginas administrativas para proporcionar una descripción general de su funcionalidad.',
