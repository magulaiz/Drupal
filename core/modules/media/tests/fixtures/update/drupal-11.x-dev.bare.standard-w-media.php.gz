])
->values([
  'lid' => '8079',
  'translation' => 'Configure tu sitio para que cron se ejecute periódicamente.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8080',
  'translation' => 'Si su web no se está comportando como esperaba, limpie la memoria caché de esta antes de intentar diagnosticar el problema.',
  'language' => 'es',
  'customized' => '0',
])
->values([
