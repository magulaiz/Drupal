  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8504',
  'translation' => 'El complemento <em>Editar código fuente</em> se habilitó para admitir etiquetas y/o atributos que no son explícitamente compatibles con ningún complemento de CKEditor 5 disponible.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8505',
  'translation' => 'Estos son los encabezados que aparecerán en el menú desplegable de encabezados. Si no se elige un encabezado aquí, no significa necesariamente que la etiqueta correspondiente no esté permitida en el formato de texto.',
