])
->values([
  'lid' => '6413',
  'translation' => 'Para más información, consulte la entrada del manual online para <a href=":memory-limit">incrementar el limite del memoria de PHP</a>.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '6414',
  'translation' => 'Consulte <a href=":url">@url</a> para obtener más información sobre el archivo .htaccess recomendado que debería ser añadido en el directorio %directory para ayudarle a protegerse contra la ejecución de código arbitrario.',
