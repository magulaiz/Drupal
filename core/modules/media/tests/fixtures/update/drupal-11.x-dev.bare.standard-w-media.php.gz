$connection->insert('locales_source')
->fields([
  'lid',
  'source',
  'context',
  'version',
])
->values([
  'lid' => '9001',
  'source' => 'The core Language module lets you add new languages to your site, provides the <em>Language switcher</em> block, and provides the ability to configure block visibility by language; the block and block visibility settings are only available if you have multiple languages configured. The core Content Translation, Configuration Translation, and Interface Translation modules let you translate content, configuration, and the built-in user interface, respectively. The core Update Manager module manages automatic downloads of community-provided translations of default configuration and user-interface text. See the related topics listed below for specific tasks.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9002',
  'source' => 'Here are some tasks and hints related to maintaining your site, and troubleshooting problems that may come up on your site. See the related topics below for more information.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9003',
  'source' => 'When performing maintenance, such as installing, uninstalling, or updating a module, put your site in maintenance mode.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9004',
  'source' => 'There are several site reports that can help you diagnose problems with your site. There are also two core modules that can be used for error logging: Database Logging and Syslog.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9005',
  'source' => '<a href="https://www.drupal.org/docs/user_guide/en/prevent-chapter.html">Preventing and Fixing Problems (Drupal User Guide)</a>',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9006',
  'source' => 'Manage the search index, and make sure that the site is fully indexed for searching.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9007',
  'source' => 'What is the search index?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9008',
  'source' => 'Under <em>Indexing throttle</em>, select the <em>Number of items to index per cron run</em>. A smaller number will make cron faster and reduce the possibility of timeout; a larger number will make sure more of your site is indexed in fewer cron runs.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9009',
  'source' => 'Under <em>Default indexing settings</em>, enter the desired <em>Minimum word length to index</em>. Words smaller than this length will be dropped from both keywords when searching and content when indexing.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9010',
  'source' => 'Click <em>Save configuration</em>, and you should be returned to the <em>Search pages</em> page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9011',
  'source' => 'Click <em>Re-index site</em> if you have changed the indexing configuration, or later on, if you believe that the search index has been corrupted.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9012',
  'source' => 'After waiting for cron to run several times, verify that the content has been fully indexed for searching. The overall status is listed under <em>Indexing progress</em>, and the status for each search page is shown in the <em>Indexing progress</em> column of the <em>Search pages</em> section.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9013',
  'source' => 'Scroll down to the <em>Search pages</em> section. You will see a list of the already-configured search pages on your site.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9014',
  'source' => 'To configure an existing search page, click <em>Edit</em>. Or, to add a new search page, select the <em>Search page type</em> and click <em>Add search page</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9015',
  'source' => 'Enter the desired <em>Label</em> name and URL <em>Path</em> for the search page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9016',
  'source' => 'For <em>Content</em> search pages, select the desired level of influence in ranking search results of the available <em>Content ranking</em> factors.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9017',
  'source' => 'Click <em>Save</em>. You will be returned to the <em>Search pages</em> page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9018',
  'source' => 'Verify that the correct search page is listed as <em>Default</em> in the <em>Status</em> column. If not, click <em>Set as default</em> in the <em>Operations</em> list for the correct search page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9019',
  'source' => 'Follow the steps in @search_index_topic to make sure that the search index is updated.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9020',
  'source' => 'What are search pages?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9021',
  'source' => 'The core Search module organizes site search into <em>pages</em>. Each page allows users to search a particular type of content with a particular configuration. The configuration includes specifying a URL that starts with <em>search</em>, a name for the page, and additional options for some search page types.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9022',
  'source' => 'When users visit the main search page (see @search_link), they will see the configured search pages that they have access to. Each search page has a search form on it, and the page will display search results after the user enters keywords into the form and clicks the search button.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9023',
  'source' => 'What modules provide site search?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9024',
  'source' => 'The core Search module provides the ability to configure search pages; search page types are provided by both core and contributed modules. The core modules that provide search page types are:',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9025',
  'source' => 'The Node module, for searching content pages',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9026',
  'source' => 'The User module, for searching user profiles',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9027',
  'source' => 'The Help module, for searching help topics',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9028',
  'source' => "As an alternative to the core Search module's system of search pages, you can use contributed modules to provide site search. For example, the <a href=\"https://www.drupal.org/project/apachesolr\">Apache Solr</a> and <a href=\"https://www.drupal.org/project/sphinx\">Sphinx</a> contributed modules use third-party technology to provide site search.",
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9029',
  'source' => 'What are the limitations of the core Search module?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9030',
  'source' => 'There are two main limitations of the core Search module. First, it is not appropriate for very large sites -- if you have a large site, look into other search technologies like Apache Solr. Second, the Node search page type only supports exact keyword matching, which is not the behavior that most users will expect. You can improve this by installing a language-specific stemming module for your language (such as <a href="https://www.drupal.org/project/porterstemmer">Porter Stemmer</a> for American English), which makes it so that, for example, a search for the word walk would match pages containing the words walk, walking, and walked.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9031',
  'source' => 'What are the search permissions?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9032',
  'source' => 'In addition to <em>Use search</em>, <em>View user information</em> permission is needed for searching users.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9033',
  'source' => 'In addition to <em>Use search</em>, <em>View published content</em> permission is needed for searching content.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9034',
  'source' => 'Users with <em>Use advanced search</em> permission can use more complex search filtering when performing content searches.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9035',
  'source' => 'Configuring site search overview',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9036',
  'source' => '<a href="https://www.drupal.org/documentation/modules/search">Online documentation for the Search module</a>',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9037',
  'source' => 'Install a core module, or a contributed module that has already been downloaded.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9038',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>@extend_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9039',
  'source' => 'Enter a word from the module name or description into the filter box, to make the list of modules smaller. Locate the module you want to install.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9040',
  'source' => 'Check the box next to the name of the module you want to install; you can also check more than one box to install multiple modules at the same time. If the checkbox is disabled for the module you are trying to install, expand the information to see why -- you may need to download an additional module that your module requires.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9041',
  'source' => 'Click <em>Install</em> at the bottom of the page. If you chose to install a module with dependencies that were not already installed, or if you chose an Experimental module, confirm your choice on the next page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9042',
  'source' => 'Wait for the module (or modules) to be installed. You should be returned to the <em>Extend</em> page with a message saying the module or modules were installed.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9043',
  'source' => 'Put your site in maintenance mode to perform maintenance operations, and then return to normal mode when finished.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9044',
  'source' => 'What is maintenance mode?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9045',
  'source' => 'When your site is in maintenance mode, most site visitors will see a simple maintenance mode message page, rather than being able to use the full functionality of the site. Users with <em>Use the site in maintenance mode</em> permission who are already logged in will be able to use the full site, and the log in page at <em>/user</em> will also be accessible to anyone.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9046',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Development</em> &gt; <em>@maintenance_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9047',
  'source' => 'Check <em>Put site into maintenance mode</em>, optionally change the <em>Message to display when in maintenance mode</em>, and click <em>Save configuration</em>. Your site will be in maintenance mode.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9048',
  'source' => 'Perform your maintenance operations.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9049',
  'source' => 'Uncheck <em>Put site into maintenance mode</em> and click <em>Save configuration</em>. Your site will be back in normal operation mode.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9050',
  'source' => 'Run reports to learn about the status and health of your site.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9051',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Reports</em> &gt; <em>@status_link</em> to see a report that summarizes the health and status of your site. If there are any warnings or errors, you will need to fix them. Take note of any upcoming highly critical security releases that may impact your site.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9052',
  'source' => 'If you have the core Database Logging module installed, in the <em>Manage</em> administrative menu, navigate to <em>Reports</em> &gt; <em>Recent log messages</em> to see a report of the error and informational messages your site has generated. You can filter the report by <em>Severity</em> to see only the most critical messages, if desired.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9053',
  'source' => 'If you have the core Update Manager module installed, in the <em>Manage</em> administrative menu, navigate to <em>Reports</em> &gt; <em>Available updates</em> to see a report of the updates that are available for your site software. If <em>Last checked</em> is far in the past, click <em>Check manually</em> to update the report. Scan the report; if the core software or any modules or themes have security updates available, you should update them as soon as possible.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9054',
  'source' => "<a href=\"https://www.drupal.org/docs/user_guide/en/security-chapter.html\">Security and Maintenance (Drupal User Guide)</a>, which includes information on how to update your site's core software, modules, and themes.",
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9055',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>System</em> &gt; <em>@information_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9056',
  'source' => 'Click <em>Save configuration</em>. You should see a message indicating that the settings were saved.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9057',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Region and language</em> &gt; <em>@regional_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9058',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Region and language</em> &gt; <em>@datetime_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9059',
  'source' => 'Look at the <em>Patterns</em> for the Default long, medium, and short date formats. If any of them does not match the date format you want to use on your site, click <em>Edit</em> in that row to edit the format.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '9060',
  'source' => 'Adjust the <em>Format string</em> until the <em>Displayed</em> format matches what you want. (Date format strings are composed of PHP date format codes.)',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
