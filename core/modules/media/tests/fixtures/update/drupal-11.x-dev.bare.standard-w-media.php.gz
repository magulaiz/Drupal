->values([
  'lid' => '8517',
  'translation' => 'CKEditor 5 sólo funciona con formatos de texto basados en HTML. El filtro "%filter_label" (%filter_plugin_id) implica que este formato de texto ya no es HTML.',
  'language' => 'es',
  'customized' => '0',
