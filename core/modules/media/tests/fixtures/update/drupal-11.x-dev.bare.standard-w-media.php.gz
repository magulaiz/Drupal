  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7965',
  'translation' => 'El módulo principal Shortcuts mejora la barra de herramientas con una lista configurable de enlaces a tareas de uso común.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '7966',
