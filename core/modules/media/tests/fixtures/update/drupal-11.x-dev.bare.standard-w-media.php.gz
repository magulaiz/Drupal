->values([
  'lid' => '8391',
  'source' => 'taxonomy/term/6: Path to a taxonomy term page.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8392',
  'source' => 'What is an alias?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8393',
  'source' => 'Overview of configuring paths, aliases, and URLs',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8394',
  'source' => 'Configuring taxonomy',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8395',
  'source' => 'Create a taxonomy vocabulary and add a reference field for that vocabulary to a content entity. See @taxonomy_overview_topic for information about taxonomy and @content_structure_topic for more on content entities.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8396',
  'source' => 'Who can configure a taxonomy vocabulary?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8397',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Structure</em> &gt; <em>@taxonomy_admin_link</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8398',
  'source' => 'Click <em>Add vocabulary</em>.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8399',
  'source' => 'In the <em>Name</em> field, enter a name for the vocabulary (for example "Ingredients"), which is how it will be shown in the administrative interface. Optionally, add a description.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8400',
  'source' => 'Click <em>Save</em>. Your vocabulary will be created and you will see the page that lists all the terms in this vocabulary.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8401',
  'source' => 'Managing taxonomy',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8402',
  'source' => 'What is taxonomy?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8403',
  'source' => '<em>Taxonomy</em> is used to classify website content. One common example of taxonomy is the tags used to classify or categorize posts in a blog website; a cooking website could use an ingredients taxonomy to classify recipes. Individual taxonomy items are known as <em>terms</em> (the blog tags or recipe ingredients in these examples); and a set of terms is known as a <em>vocabulary</em> (the set of all blog post tags, or the set of all recipe ingredients in these examples). Technically, taxonomy terms are an entity type and the entity subtypes are the vocabularies; see @content_structure_topic for more on content entities. Like other entities, taxonomy terms can have fields attached; for instance, you could set up an image field to contain an icon for each term.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8404',
  'source' => 'An individual vocabulary can organize its terms in a hierarchy, or it could be flat. For example, blog tags normally have a flat structure, while a recipe ingredients vocabulary could be hierarchical (for example, tomatoes could be a sub-term of vegetables, and under tomatoes, you could have green and red tomatoes).',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8405',
  'source' => 'Taxonomy terms are normally attached as reference fields to other content entities, which is how you can use them to classify content. When you set up a taxonomy reference field, you can let users enter terms in two ways:',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8406',
  'source' => 'New terms can be created right on the content editing form.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8407',
  'source' => 'Fixed list of terms',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8408',
  'source' => 'The list of terms is curated and managed outside the content editing form, and users can only select from the existing list when editing content.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8409',
  'source' => '<em>Page settings</em>, <em>Block settings</em>, etc.: settings specific to the display type, such as the URL for a page display. Most display types support an <em>Access</em> setting, where you can choose a Permission or Role that a user must have in order to see the view.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8410',
  'source' => 'Who can edit views?',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8411',
  'source' => 'In the <em>Manage</em> administrative menu, navigate to <em>Structure</em> &gt; <em>@views</em>. A list of all views is shown.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8412',
  'source' => "Verify that the <em>Access</em> settings for the view are at least as restrictive as the permissions necessary to perform the bulk operations. People with permission to see the view, but who don't have permission to do the bulk operations, will experience problems.",
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8413',
  'source' => 'Click <em>Save</em>. The action(s) will be available as bulk operations in the view.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8414',
  'source' => 'Export a single configuration item to a file. See @config_overview_topic for more information about configuration.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8415',
  'source' => 'Import the complete configuration of your site from an archive file, such as one that was previously exported (see @export_full_topic). See @config_overview_topic for more information about configuration.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8416',
  'source' => 'Import a single configuration item in YAML format, such as one that was previously exported (see @export_single_topic). See @config_overview_topic for more information about configuration.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8417',
  'source' => 'Translate your site configuration to another language. See @language_add_topic if you need to add a new language.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8418',
  'source' => 'Find either the configuration entity type or the simple configuration item that you want to translate in the <em>Label</em> column of the list. Click <em>List</em> under <em>Operations</em> for a configuration entity, or <em>Translate</em> for simple configuration. (See @config_overview_topic to learn more about types of configuration and configuration entities.)',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8419',
  'source' => 'The contact form will always have <em>Subject</em> and <em>Message</em> fields. If you want to add more fields, follow the steps in @adding_fields_topic.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8420',
  'source' => 'Create or edit a workflow with various workflow states (for example <em>Concept</em>, <em>Archived</em>, etc.) for moderating content. See @workflows_overview_topic for more information on workflows.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8421',
  'source' => 'Configure language and translation settings for one or more content entity types (see @content_structure_topic for an overview of content entities). To do this, you must have at least two languages configured. Afterwards, you will have a <em>Translate</em> operation available for your content entities, either as a tab or link when you are viewing or editing content, or on content administration pages.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8422',
  'source' => 'Content (blocks, content items, etc.) can be written in English or another language, and can be translated into additional languages. See @content_structure_topic to learn more about content.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8423',
  'source' => "Many configuration items also include text that can be translated. Default configuration provided by your site's software is provided in English; you can also download community-provided translations. See @config_overview_topic to learn more about configuration.",
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8424',
  'source' => 'Configure a text format so that when a user is editing text and selects this text format, a text editor installed on your site is shown. Configure the text editor, such as choosing which buttons and functions are available. See @filter_overview_topic for more about text formats.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8425',
  'source' => 'Follow the steps on @filter_overview_topic to add a new text format or configure an existing text format; when you reach the step about text editors, return to this topic.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8426',
  'source' => 'Return to @filter_overview_topic to complete the text format configuration, and be sure to save the text format.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8427',
  'source' => 'Add an entity reference field to an entity sub-type; see @content_structure_topic for more information on entities and reference fields.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8428',
  'source' => 'Check the indexing status of the Help search page. If it is not fully indexed, see @cron_topic about how to run Cron until indexing is complete.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8429',
  'source' => 'In the future, you can click <em>Rebuild search index</em> on this page, or @cache_topic, in order to force help topic text to be reindexed for searching. This should be done whenever a module, theme, language, or string translation is updated.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8430',
  'source' => 'Add a new image style, which can be used to process and display images. See @media_topic for an overview of image styles.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8431',
  'source' => 'Configure an entity sub-type to have its fields displayed using a layout (see @content_structure_topic for more on entities and fields).',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8432',
  'source' => 'A layout consists of one or more <em>sections</em>. Each section can have from one to four <em>columns</em>. You can place blocks, including special blocks for the fields on the entity sub-type, in each column of each section (see @block_overview_topic for more on blocks).',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8433',
  'source' => 'Add a new media type that can be referenced in Media reference fields; media types are a content entity type. See @media_topic for an overview of media items and media types, and @content_structure_topic for more information on content entities and fields.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8434',
  'source' => 'Migrate data into a new, empty site, as part of an upgrade from an older version of Drupal. See @migrate_overview_topic for an overview of migrating and upgrading.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8435',
  'source' => 'Configure a responsive image style, which can be used to display images at different sizes on different devices. See @media_topic for an overview of responsive image styles, and @breakpoint_overview_topic for an overview of breakpoints.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8436',
  'source' => 'Select a <em>Fallback image style</em> to use when none of the other styles apply. See @image_style_topic if you need to add a new style.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8437',
  'source' => 'The <em>Content</em> and <em>Help</em> search types provided by the core software pre-index their content and store the results in several database tables that are collectively called the <em>search index</em>. The process of indexing renders the content and breaks it up into words, which can then be matched more efficiently with keyword queries when users perform searches. Search indexing happens during cron runs; see @cron_topic for more information about cron.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8438',
  'source' => 'Follow the steps in @cron_topic to make sure a cron task has been configured.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8439',
  'source' => 'In order to configure site search using the core Search module, you will need to configure one or more search pages. You will also need to verify or alter permissions so that the desired user roles can search the site. (See @user_overview_topic for more information about roles and permissions.) For content search, you will also need to make sure that the search index is configured and that the site is fully indexed. Finally, you may wish to place the <em>Search form</em> block on pages of your site, or add the search page to a navigation menu, to give users easy access to search. See the related topics listed below for specific tasks.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8440',
  'source' => 'Clear the site cache. See @cache_topic for instructions.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8441',
  'source' => 'Uninstall a module. Your site should be in <em>maintenance mode</em> when you uninstall modules. See @maintenance_topic for details.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8442',
  'source' => 'Find the section whose settings you want to change, such as <em>Format</em> or <em>Filter criteria</em>. (See @views_overview_topic for more information.)',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8443',
  'source' => 'The core software allows you to configure workflows in which each transition has an associated permission that can be granted to a particular role. See @configuring_workflows_topic for more information.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8444',
  'source' => 'Users with sufficient permissions can change the workflow state of a particular entity. See @changing_states_topic for more information.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
  'lid' => '8445',
  'source' => 'Remote oEmbed providers database returned invalid or empty list. Using previously stored data. This may contain out of date information.',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8446',
  'source' => 'Block type settings',
  'context' => '',
  'version' => 'none',
])
->values([
  'lid' => '8447',
  'source' => '@bundle_type is not @bundles or @last',
  'context' => '',
  'version' => 'none',
