])
->values([
  'lid' => '8171',
  'translation' => 'Drupal es una plataforma de código abierto para crear increíbles experiencias digitales. Está hecho y es usado, enseñado, documentado y comercializado por la <a href="@drupal_community">Comunidad de Drupal </a>. Nuestra comunidad está formada por personas de todo el mundo con un grupo de <a href="@drupal_values"> valores</a> compartidos, que colaboran juntos de manera respetuosa. Como nos gusta decir:',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8172',
  'translation' => 'Ven por el código, te quedarás por la comunidad.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8173',
  'translation' => 'Hay algunas formas de comenzar con Drupal:',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8174',
  'translation' => '<a href="@drupal_user_guide"> La guía del usuario: </a> incluye la instalación, administración, creación de sitios y mantenimiento del contenido de un sitio web con Drupal.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8175',
  'translation' => '<a href="@create_content">Crear contenido:</a> ¿Quiere ponerse manos a la obra? Comience por crear contenido. <strong>Aviso:</strong> La información de esta página desaparecerá en cuanto cree contenido para su sitio web. Siga leyendo y añada los recursos que le interesen a sus marcadores.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8176',
  'translation' => '<a href="@drupal_extend"> Extienda Drupal: </a> el núcleo de Drupal se puede ampliar y personalizar de formas extraordinarias. Instale funcionalidades adicionales y cambie el aspecto de su sitio utilizando complementos aportados por nuestra comunidad.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8177',
  'translation' => 'Marque estos enlaces a nuestros grupos activos de la comunidad de Drupal y a recursos de soporte.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8178',
  'translation' => '<a href="@drupal_events">Próximos eventos: </a> Aprenda y conéctese con otras personas en conferencias y eventos celebrados en todo el mundo.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8179',
  'translation' => '<a href="@drupal_community">Página de la comunidad: </a> Lista de grupos principales de la comunidad de Drupal con su propio contenido.',
  'language' => 'es',
  'customized' => '0',
])
->values([
  'lid' => '8180',
  'translation' => 'Compruebe <a href="https://www.php.net/manual/datetime.format.php#refsect1-datetime.format-parameters" target="_blank">la documentación para formatos de fecha de PHP</a>.',
  'language' => 'es',
