  'version' => '11.0-dev',
])
->values([
  'lid' => '8116',
  'source' => 'The <em>Breakpoint</em> module allows you to define breakpoints and breakpoint groups in YAML files. Modules and themes can use the API provided by the <em>Breakpoint</em> module to define breakpoints and breakpoint groups, and to assign resolution multipliers to breakpoints.',
  'context' => '',
  'version' => '11.0-dev',
])
->values([
