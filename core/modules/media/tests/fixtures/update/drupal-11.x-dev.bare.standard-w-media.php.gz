])
->values([
  'lid' => '8476',
  'translation' => 'Esta vista se mostrará al visitar esta ruta en su sitio. Puede usar "%" o parámetros de ruta con nombre como "%node" en su URL para representar valores que se usarán para filtros contextuales: por ejemplo, "node/%node/feed" o "view_path/%". Los parámetros de ruta con nombre son necesarios cuando esta ruta coincide con una ruta existente. Por ejemplo, rutas como "taxonomy/term/%taxonomy_term" o "user/%user/custom-view".',
  'language' => 'es',
  'customized' => '0',
])
->values([
