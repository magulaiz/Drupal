])
->values([
  'lid' => '8245',
  'translation' => 'Los registros del módulo Database Logging pueden ser eliminados por los administradores y/o tareas automatizadas, por lo que no deberían ser utilizados para <a href=":audit_trail_wiki">registros forenses</a>. Para propósitos forenses, utilice el módulo Syslog.',
