<?php

/**
 * @file
 * Support module for testing a filtered permissions list.
 */

/**
 * Implements hook_user_permission_list_alter().
 */
function user_filtered_permissions_test_user_permission_list_alter(&$permissions) {
  foreach ($permissions as $key => $value) {
    if (!in_array($key, ['a', 'b', 'c'])) {
      unset($permissions[$key]);
    }
  }
}
