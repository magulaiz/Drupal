{% set id = id|default('myradios-' ~ random()) %}

<div{{ attributes.addClass('mb-3') }}>
  {% for value, option in options %}
    {% set option_id = id ~ '-' ~ loop.index0 %}
    {% set input_attributes = create_attribute({
      class: [
        'form-check-input'
      ],
      type: 'radio',
      name: form_state.name,
      id: option_id,
      value: value,
      checked: (value == form_state.value) ? 'checked',
    }) %}
    <div class="form-check">
      <input{{ input_attributes }}>
      <label class="form-check-label" for="{{ option_id }}">
        {{ option }}
      </label>
    </div>
  {% endfor %}
</div>
