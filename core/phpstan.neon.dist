# Configuration file for PHPStan static code checking, see https://phpstan.org .
# PHPStan is triggered on Drupal CI in commit-code-check.sh.
includes:
	- phpstan-baseline.neon

parameters:

  level: 0

  fileExtensions:
    - engine
    - inc
    - install
    - module
    - php
    - profile
    - theme

  bootstrapFiles:
    - ../vendor/mglaman/phpstan-drupal/drupal-autoloader.php

  drupal:
    drupal_root: '%currentWorkingDirectory%'

  paths:
    - .
    - ../composer

  excludePaths:
    - '*.api.php'
    - 'lib/Drupal/Component/Diff/Engine/*.php'
    - lib/Drupal/Core/Database/Statement.php
    - 'modules/migrate_drupal/tests/fixtures/*.php'
    - modules/system/tests/modules/plugin_test/src/Plugin/plugin_test/fruit/ExtendingNonInstalledClass.php
    - tests/Drupal/Tests/Listeners/HtmlOutputPrinter.php

  reportUnmatchedIgnoredErrors: false

  ignoreErrors:
    # new static() is a best practice in Drupal, so we cannot fix that.
    - "#^Unsafe usage of new static#"

    # Ignore common errors for now.
    - "#^Access to an undefined property#"
    - "#^Call to an undefined method#"
    - "#^Cannot unset offset#"
    - "#should return .* but return statement is missing#"

parametersSchema:
  drupal: structure([
    drupal_root: string()
  ])

services:
  -
    class: mglaman\PHPStanDrupal\Drupal\ServiceMap
