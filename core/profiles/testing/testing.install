<?php

/**
 * @file
 * Install, update and uninstall functions for the testing installation profile.
 */

/**
 * Implements hook_site_install_finished().
 *
 * Perform test action after the install has completed.
 */
function testing_site_install_finished($install_state) {
  \Drupal::messenger()->addMessage('Perform action after the installation.');
}
