<article{{ attributes.addClass('card') }}>

  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes.addClass('card__title') }}>
      {{ label }}
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('card__content') }}>
    {{ content }}
  </div>

  <div class="read-more">
    <a class="read-more__link" href="{{ url }}">
      {% trans %}View {{ node.type.entity.label() }}{% endtrans %} <span class="visually-hidden"> - {{ label }}</span>
    </a>
  </div>

</article>
