<div class="umami-search-iconwrap">
  <a class="umami-search-link" title="{{ 'Go to the search page'|t }}" href="{{ path('search.view') }}">
    <span class="umami-search-icon" aria-hidden="true">{% include "@demo_umami/themes/umami/images/svg/search.svg" %}</span>
    <span class="visually-hidden">{{ 'Search'|t }}</span>
  </a>
</div>

<div{{ attributes.addClass('umami-search') }}>
  {{ label }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
