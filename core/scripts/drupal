#!/usr/bin/env php
<?php

/**
 * @file
 * Provides CLI commands for Drupal.
 */

use Drupal\Core\Command\GenerateTheme;
use Drupal\Core\Command\QuickStartCommand;
use Drupal\Core\Command\InstallCommand;
use Drupal\Core\Command\ServerCommand;
use Symfony\Component\Console\Application;

if (PHP_SAPI !== 'cli') {
  return;
}

// Get the Composer autoloader. This needs to use exec('pwd') rather than
// 'getcwd' in order to get the directory the script is being run from without
// any symlinks being resolved. This ensures the script can be run from any
// location in the codebase.
$classloader = require_once dirname(exec("pwd") . '/' . trim($_SERVER['argv'][0], './'), 3) . '/autoload.php';

$application = new Application('drupal', \Drupal::VERSION);

$application->add(new QuickStartCommand());
$application->add(new InstallCommand($classloader));
$application->add(new ServerCommand($classloader));
$application->add(new GenerateTheme($classloader));

$application->run();
