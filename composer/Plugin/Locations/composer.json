{
  "name": "drupal/core-drupal-locations",
  "description": "Writes a class defining Drupal's install location.",
  "type": "composer-plugin",
  "keywords": ["drupal"],
  "homepage": "https://www.drupal.org/project/drupal",
  "license": "GPL-2.0-or-later",
  "require": {
    "composer-plugin-api": "^1 || ^2",
    "php": ">=7.3.0"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\Composer\\Plugin\\Locations\\": ""
    }
  },
  "extra": {
    "class": "Drupal\\Composer\\Plugin\\Locations\\LocationWriterPlugin",
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "composer/composer": "^1.8@stable"
  }
}
