<?php

/**
 * @file
 * Contains tests for the announcements_feed module.
 */

/**
 * Tests for validating Json feed with different urls.
 */
class AnnounceTestValidateJsonFeed extends DrupalWebTestCase {

  /**
   * A user with permission to access toolbar and access announcements.
   *
   * @var object
   */
  protected $user1;
  /**
   * A user with permission to access toolbar and access announcements.
   *
   * @var object
   */
  protected $user2;
  /**
   * A user with permission to access toolbar and access announcements.
   *
   * @var object
   */
  protected $user3;
  /**
   * A test endpoint which contains the community feeds.
   *
   * @var string
   */
  protected $responseJson;
  /**
   * A test endpoint which include the new feeds.
   *
   * @var string
   */
  protected $updatedJson;
  /**
   * A test endpoint which displays an empty json.
   *
   * @var string
   */
  protected $emptyJson;
  /**
   * A test endpoint that will have some feeds removed.
   *
   * @var string
   */
  protected $removed;

  public static function getInfo() {
    return array(
      'name' => 'Validate Json Feeds',
      'description' => 'Checking how the code handle multiple types of json feeds',
      'group' => 'Announcements Feed',
    );
  }

  public function setUp() {
    global $base_url;
    global $base_path;
    module_load_include('inc', 'announce_test', 'announce_test');
    parent::setUp(array(
      'user',
      'toolbar',
      'announcements_feed',
      'announce_test',
    ));
    $this->user1 = $this->drupalCreateUser(array(
      'access toolbar',
      'access announcements',
    ));
    $this->user2 = $this->drupalCreateUser(array(
      'access toolbar',
      'access announcements',
    ));
    $this->user3 = $this->drupalCreateUser(array(
      'access toolbar',
      'access announcements',
    ));
    $this->responseJson = $base_url . $base_path . 'announce-feed-json/community-feeds';
    $this->updatedJson = $base_url . $base_path . 'announce-feed-json/updated';
    $this->emptyJson = $base_url . $base_path . 'announce-feed-json/empty';
    $this->removed = $base_url . $base_path . 'announce-feed-json/removed';
    set_announce_test_endpoint($this->responseJson);
  }

  /**
   * Testing the feed notification with different kind of urls.
   */
  public function testAnnounceFeedUpdated() {
    module_load_include('inc', 'announce_test', 'announce_test');
    $this->drupalLogin($this->user2);
    $this->drupalGet('');
    $this->clickLink('Community Announcements');
    $this->drupalLogout();

    $this->drupalLogin($this->user1);
    $this->drupalGet('');
    $this->clickLink('Community Announcements');

    $this->drupalGet('');
    $alert_elements = $this->xpath("//a[@class='announce-new']");
    $this->assertEqual(0, count($alert_elements), 'No New Announcement Exist');

    // Add new items to the announce-feed and
    // logged in as a user who has "access announcements" permission.
    // Change the feed url to updated json file which contain new feeds.
    // This is check if the user has new announcement is it been reflected on
    // the site. Setup test announce endpoint.
    set_announce_test_endpoint($this->updatedJson);
    drupal_flush_all_caches();

    $this->drupalGet('');
    $unread_alert_elements = $this->xpath("//a[@class='announce-new']");

    // Assert the '.announce-new' class is added when there are new
    // announcements.
    // Alert Icon should display a red dot over it.
    $this->assertEqual(array_key_exists(0, $unread_alert_elements), TRUE, 'New Announcement Exist');

    $this->clickLink('Community Announcements');
    $unread_msg_count = count($this->xpath("//div[@class='unread_status']"));
    // Total number of unread records.
    $total_updated_records_count = 1;

    $this->assertEqual($unread_msg_count, $total_updated_records_count, 'Matches the total number of updated records');
    $this->assertText('Only 9 - Drupal 106 is available and this feed is Updated');
    $this->drupalLogout();

    // Login user second time.
    $this->drupalLogin($this->user1);

    $this->drupalGet('');
    // Check if unread messages are there in site.
    $this->assertEqual(0, count($this->xpath("//div[@class='unread_status']")), 'No new messages');
    $this->clickLink('Community Announcements');
    $this->assertEqual(0, count($this->xpath("//div[@class='unread_status']")), 'No new announcements');

    // Login as another user and access the alert icon.
    $this->drupalLogin($this->user2);
    $this->drupalGet('');

    $unread_alert_elements = $this->xpath("//a[@class='announce-new']");

    // Assert the '.announce-new' class is added when there are new
    // announcements.
    // Alert Icon should display a red dot over it.
    $this->assertEqual(array_key_exists(0, $unread_alert_elements), TRUE, 'New Announcement Exist');

    $this->clickLink('Community Announcements');
    $unread_msg_count = count($this->xpath("//div[@class='unread_status']"));
    // Total number of unread records.
    $total_updated_records_count = 1;

    $this->assertEqual($unread_msg_count, $total_updated_records_count, 'Matches the total number of updated records');
    $title = $this->xpath("//div[@id='new-feed-standard']/div/a[text()='Only 9 - Drupal 106 is available and this feed is Updated']");
    $this->assertEqual(array_key_exists(0, $title), TRUE, 'Title Exist');
    $this->assertText('announce title updated');

    $this->drupalLogout();
  }

  /**
   * Check the status of the red dot icon when few items are drop from the feed.
   */
  public function testAnnounceFeedRemoved() {
    $this->drupalLogin($this->user3);
    $this->drupalGet('');
    $this->clickLink('Community Announcements');
    $this->assertEqual(0, count($this->xpath("//a[@class='announce-new']")), 'No new messages');
    $this->clickLink('Community Announcements');
    $this->assertEqual(0, count($this->xpath("//div[@class='unread_status']")), 'No new messages');
    $this->assertNoText('Only 9 - Drupal 106 is available and this feed is Updated');

    // Change the feed url to updated json file.
    // For resetting temp storage.
    set_announce_test_endpoint($this->updatedJson);
    drupal_flush_all_caches();

    $this->drupalGet('');
    $this->assertEqual(array_key_exists(0, $this->xpath("//a[@class='announce-new']")), TRUE, 'New Announcement Exist');
    $this->clickLink('Community Announcements');
    $this->assertEqual(count($this->xpath("//div[@class='unread_status']")), 1, 'Matches the total number of updated records');
    $this->assertText('Only 9 - Drupal 106 is available and this feed is Updated');
    $this->drupalLogout();

    // Change the feed url to removed feeds json file.
    // For resetting temp storage.
    set_announce_test_endpoint($this->removed);
    drupal_flush_all_caches();
    $this->drupalLogin($this->user3);

    // If the removed item is only item the
    // user hasn't read the red dot should not show.
    $this->drupalGet('');
    $this->assertEqual(0, count($this->xpath("//a[@class='announce-new']")), 'No new messages');

    // Removed items should not display in the announcement model.
    $this->clickLink('Community Announcements');
    $this->assertEqual(0, count($this->xpath("//div[@class='unread_status']")), 'No new messages');
    $this->assertNoText('Only 9 - Drupal 106 is available and this feed is Updated');

  }

  /**
   * Check the status of the red dot alert with an empty JSON feed.
   */
  public function testAnnounceFeedEmpty() {
    // Change the feed url to empty json file.
    // For resetting temp storage.
    set_announce_test_endpoint($this->emptyJson);
    drupal_flush_all_caches();

    $this->drupalLogin($this->user3);
    $this->drupalGet('');
    $this->assertEqual(0, count($this->xpath("//a[@class='announce-new']")), 'No new messages');

    // Removed items should not display in the announcement model.
    $this->clickLink('Community Announcements');
    $this->assertEqual(0, count($this->xpath("//div[@class='unread_status']")), 'No new messages');
    $this->assertText('No announcements available');
  }

}
/**
 * Unit test for module functions.
 */
class AnnounceTestValidateUrl extends DrupalUnitTestCase {

  public static function getInfo() {
    return array(
      'name' => 'Validate URL',
      'description' => 'Unit test for the module to check the validate url function',
      'group' => 'Announcements Feed',
    );
  }

  public function setUp() {
    parent::setUp('announcements_feed');
    module_load_include('inc', 'announcements_feed', 'announcements_feed');
  }

  /**
   * Test for validating the announcements_feed_validate_url function.
   */
  public function testValidateUrl() {
    $urls = array(
      array('https://www.drupal.org', TRUE),
      array('https://api.drupal.org', TRUE),
      array('https://www.example.org', FALSE),
      array('https://api.example.org/project/announce', FALSE),
      array('https://a.example.org/project/announce', FALSE),
      array('https://test.drupaal.com', FALSE),
      array('https://api.drupal.org.example.com', FALSE),
    );
    foreach ($urls as $url) {
      $result = announcements_feed_validate_url(array('link' => $url[0]));
      $this->assertEqual($url[1], $result, 'Returned' . $url[1]);
    }
  }

}
/**
 * Testing the Announce login test cases.
 */
class AnnounceTestValidateLoginTestCase extends DrupalWebTestCase {

  public static function getInfo() {
    return array(
      'name' => 'Validate login',
      'description' => 'Checking the notification alert when a new user logs in and won\'t appear next the user log in',
      'group' => 'Announcements Feed',
    );
  }

  public function setUp() {
    global $base_url;
    global $base_path;
    module_load_include('inc', 'announce_test', 'announce_test');
    parent::setUp(array(
      'user',
      'toolbar',
      'announcements_feed',
      'announce_test',
    ));
    $response_json = $base_url . $base_path . '/announce-feed-json/community-feeds';
    set_announce_test_endpoint($response_json);
  }

  /**
   * Test of viewing announcements by different user with permission.
   */
  public function testAnnounceValidateLogin() {
    // Create a user with proper permission.
    $this->privilegedUser = $this->drupalCreateUser(array(
      'access toolbar',
      'access announcements',
    ));
    $this->drupalLogin($this->privilegedUser);
    $this->drupalGet('');
    // Check for the new announcement class in the toolbar.
    $unread_alert_elements = $this->xpath("//a[@class='announce-new']");
    $this->assertEqual(array_key_exists(0, $unread_alert_elements), TRUE, 'New Announcement Exist');
    $this->clickLink('Community Announcements');
    $unread_msg_count = count($this->xpath("//div[@class='unread_status']"));
    $title_count = count($this->xpath("//div[@class='announcement_title']"));
    // Check if unread messages are there in site.
    $this->assertNotEqual(0, $unread_msg_count, 'Contains new messages');
    // Since it new login all the messages should be unread message.
    $this->assertEqual($unread_msg_count, $title_count, 'Unread messages matches the number of messages');
    $this->drupalLogout();
    // Log-in again to check if the unread messages are read.
    $this->drupalLogin($this->privilegedUser);
    // Check for alert is popping up.
    $read_alert_elements = $this->xpath("//a[@class='announce-new']");
    $this->assertEqual(0, count($read_alert_elements), 'No New Announcement Exist');
    $this->clickLink('Community Announcements');
    $unread_msg_count = count($this->xpath("//div[@class='unread_status']"));
    // Check if unread messages are there in site.
    $this->assertEqual(0, $unread_msg_count, 'No new messages');
    // Checking the same with a new user.
    $account = $this->drupalCreateUser(array(
      'access toolbar',
      'access announcements',
    ));
    $this->drupalLogin($account);
    $this->drupalGet('');
    // Check for the new announcement class in the toolbar.
    $unread_alert_elements = $this->xpath("//a[@class='announce-new']");
    $this->assertEqual(array_key_exists(0, $unread_alert_elements), TRUE, 'New Announcement Exist');
    $this->clickLink('Community Announcements');
    $unread_msg_count = count($this->xpath("//div[@class='unread_status']"));
    $title_count = count($this->xpath("//div[@class='announcement_title']"));
    // Check if unread messages are there in site.
    $this->assertNotEqual(0, $unread_msg_count, 'Contains new messages');
    // Since it new login all the messages should be unread message.
    $this->assertEqual($unread_msg_count, $title_count, 'Unread messages matches the number of messages');
    $this->drupalLogout();
  }

  /**
   * Testing the page without permission.
   */
  public function testAnnounceWithoutPermission() {
    $account = $this->drupalCreateUser(array('access toolbar'));
    $this->drupalLogin($account);
    $this->drupalGet('/admin/announcement');
    $this->assertText('You are not authorized to access this page.');
  }

}
